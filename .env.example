# Copy to .env and fill in. Never commit the real .env.
# Use sandbox creds from https://developer.tastytrade.com/sandbox/
TASTY_ENV=sandbox
TASTY_USERNAME=your_sandbox_username
TASTY_PASSWORD=your_sandbox_password
TASTY_ACCOUNT_NUMBER=5WT00000

# Optional: path to strategy config
VANTAGE_CONFIG=./config.yaml

# Logging
LOG_LEVEL=INFO
