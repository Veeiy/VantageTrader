# Copy to .env and fill in. Never commit the real .env.
#
# Session-token (username/password) auth was discontinued by tastytrade on
# 2025-12-01. Use a Personal OAuth Grant instead. To generate one:
#
#   1. Sign in at https://my.tastytrade.com  (or the sandbox site below)
#   2. Manage > API > Open API access  -> agree to terms
#   3. Manage > API > OAuth application -> create app (note client_secret)
#   4. Inside the app -> "New Personal OAuth Grant" -> check needed scopes
#      (read, trade, openid) -> copy the refresh_token
#
# Sandbox? Create a sandbox account at https://developer.tastytrade.com/sandbox/
# and repeat the above on that account's profile.
#
TASTY_ENV=sandbox                  # 'sandbox' or 'live'
TASTY_CLIENT_SECRET=               # from your OAuth application
TASTY_REFRESH_TOKEN=               # from your Personal OAuth Grant (long-lived)
TASTY_ACCOUNT_NUMBER=5WT00000      # the account this bot trades

# Optional: path to strategy config
VANTAGE_CONFIG=./config.yaml

# Logging
LOG_LEVEL=INFO

# Optional: Claude Managed Agents (Trade Reviewer, Post-Mortem Journalist, ...).
# Only needed when `agents.enabled: true` in config.yaml.

# Used by the engine to create sessions and read agent output.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only needed when `agents.environment.type: self_hosted` in config.yaml.
# These authenticate the local worker (`python -m vantage_trader worker`)
# against the work queue. Workflow:
#   1. Run `python -m vantage_trader daily-report` once -- it creates the
#      self-hosted env and logs its id.
#   2. Open the env in https://console.anthropic.com -> Workspaces -> Environments
#      and click "Generate environment key".
#   3. Paste both below.
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_ENVIRONMENT_KEY=
